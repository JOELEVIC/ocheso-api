# The Supabase project URL.
SUPABASE_URL=https://ofjnhbkdqipqheyzdvym.supabase.co

# The project's PUBLIC key (anon / sb_publishable_) - never the service-role key.
# Every request runs as its caller under row level security; this API refuses to
# start if a secret key is configured here or in SUPABASE_KEY, because a
# service-role key would bypass RLS for every anonymous request.
SUPABASE_ANON_KEY=

# Where invite links point.
SITE_URL=https://www.ocheso.com

# Origins allowed to call this API, comma-separated.
ALLOWED_ORIGINS=https://www.ocheso.com,https://ocheso.com,http://localhost:3000
